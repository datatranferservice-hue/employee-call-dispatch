# Database
DATABASE_URL=postgresql://...

# Service security
ADMIN_API_KEY=generate-a-long-random-secret
ASTERISK_EVENT_SECRET=generate-a-long-random-secret

# OpenAI webhook verification
# Preferred: paste the signing secret issued for the OpenAI project webhook.
OPENAI_WEBHOOK_SECRET=
# Temporary fallback only until signed webhook secret is configured.
OPENAI_WEBHOOK_TOKEN=generate-a-long-random-secret

# Safety controls
ALLOW_LIVE_AI_CALLS=false
REQUIRE_LEAD_AI_PERMISSION_FLAG=true
TEST_CALL_NUMBERS=
WORKER_ENABLED=true
WORKER_INTERVAL_MS=5000
DIAL_STALE_SECONDS=75

# OpenAI Realtime voice (server-side only)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_REALTIME_WS_BASE=wss://api.openai.com/v1/realtime

# Human handoff / cellphone destination, E.164 format, e.g. +15205551212
OWNER_TRANSFER_NUMBER=

# Asterisk ARI control
ASTERISK_ARI_URL=
ASTERISK_ARI_USER=
ASTERISK_ARI_PASSWORD=
ASTERISK_DIAL_CONTEXT=ssag-ai-outbound
ASTERISK_DIAL_EXTENSION=start
ASTERISK_DIAL_TIMEOUT=30

# Choose ONE outbound network leg:
# A) SIP/PSTN carrier (default when ASTERISK_CHANNEL_TEMPLATE is blank)
ASTERISK_TRUNK=carrier
# ASTERISK_CHANNEL_TEMPLATE=PJSIP/{phone}@carrier
# B) Bluetooth cellphone via Asterisk chan_mobile
# ASTERISK_CHANNEL_TEMPLATE=Mobile/owner_cell/{phone}

# OPENAI_PROJECT_ID is normally configured on the Asterisk host/dialplan because
# that machine dials sip:$OPENAI_PROJECT_ID@sip.api.openai.com;transport=tls.
