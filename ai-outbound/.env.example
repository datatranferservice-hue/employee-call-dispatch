# Database
DATABASE_URL=postgresql://...
DATABASE_SSL=true

# Service security
ADMIN_API_KEY=generate-a-long-random-secret
OPENAI_WEBHOOK_TOKEN=generate-a-long-random-secret
ASTERISK_EVENT_SECRET=generate-a-long-random-secret

# Safety controls
ALLOW_LIVE_AI_CALLS=false
REQUIRE_LEAD_AI_PERMISSION_FLAG=true
TEST_CALL_NUMBERS=
WORKER_ENABLED=true
WORKER_INTERVAL_MS=5000

# OpenAI Realtime voice (server-side only)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_API_BASE=https://api.openai.com/v1

# Asterisk ARI / SIP transport
ASTERISK_ARI_URL=
ASTERISK_ARI_USER=
ASTERISK_ARI_PASSWORD=
ASTERISK_TRUNK=
ASTERISK_STASIS_APP=ssag-ai-outbound
ASTERISK_DIAL_TIMEOUT=30
