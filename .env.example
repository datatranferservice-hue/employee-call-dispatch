# =========================================================
# CALLFLOW COMMAND — PRODUCTION CONFIGURATION
# =========================================================

NODE_ENV=production
PORT=3000

# The public HTTPS address of this server.
# Do not include a trailing slash.
APP_BASE_URL=https://your-domain.com

# PostgreSQL
DATABASE_URL=postgresql://username:password@host:5432/callflow
DATABASE_SSL=true

# Reverse proxy
TRUST_PROXY=1

# Security
SESSION_HOURS=12
ALLOWED_ORIGINS=https://your-domain.com

# Default organization settings
DEFAULT_COMPANY_NAME=Your Company
DEFAULT_TIMEZONE=America/Phoenix

# =========================================================
# OPENAI
# Keep this server-side only.
# =========================================================

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
AI_ENABLED=true

# =========================================================
# TWILIO / TELEPHONY
# Leave blank until a production telephone provider is ready.
# =========================================================

TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Refuse unsigned production telephony webhook requests.
WEBHOOK_SIGNATURE_REQUIRED=true

# =========================================================
# APPLICATION LIMITS
# =========================================================

LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_ATTEMPTS=8
MAX_JSON_BODY=1mb
