{
  "name": "callflow-command",
  "version": "2.0.0",
  "description": "Production employee call dispatch, AI operations and administration platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
