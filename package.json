{
  "name": "callflow-command",
  "version": "2.1.0",
  "description": "Production employee call dispatch and workforce operations platform",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node scripts/migrate.js && node src/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "create-owner": "node --env-file-if-exists=.env scripts/create-owner.js",
    "check": "node --check src/server.js && node --check src/db.js && node --check src/routing.js",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.3"
  }
}
